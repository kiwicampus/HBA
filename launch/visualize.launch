<launch>
  <arg name="file_path" default="/home/ada/maps/hba/"/>
  <arg name="downsample_size" default="0.1"/>
  <arg name="pcd_name_fill_num" default="0"/>
  <arg name="marker_size" default="0.5"/>
  <arg name="rviz" default="1"/>

  <node pkg="hba" type="visualize_map" name="visualize_map" output="screen">
    <param name="file_path" type="string" value="$(arg file_path)"/>
    <param name="downsample_size" type="double" value="$(arg downsample_size)"/>
    <param name="pcd_name_fill_num" type="int" value="$(arg pcd_name_fill_num)"/>
    <param name="marker_size" type="double" value="$(arg marker_size)"/>
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
      args="-d $(find hba)/rviz_cfg/rosbag.rviz"/>
  </group>
</launch>
