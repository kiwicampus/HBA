<launch>
  <!-- data_path must have a trailing slash: pose.json and pcd/ live directly under it. -->
  <arg name="data_path" default="/home/ada/maps/hba/"/>
  <arg name="total_layer_num" default="3"/>
  <arg name="thread_num" default="16"/>

  <!-- required: roslaunch exits when hba finishes (it would otherwise keep running with its master) -->
  <node pkg="hba" type="hba" name="hba" output="screen" required="true">
    <param name="data_path" type="string" value="$(arg data_path)"/>
    <param name="total_layer_num" type="int" value="$(arg total_layer_num)"/>
    <!-- liorf keyframe ids are zero-padded to 6 digits (000000, 000001, ...). -->
    <param name="pcd_name_fill_num" type="int" value="6"/>
    <param name="thread_num" type="int" value="$(arg thread_num)"/>
  </node>

  <arg name="rviz" default="0"/>
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
    args="-d $(find hba)/rviz_cfg/rosbag.rviz" />
  </group>
</launch>
