<launch>
  <arg name="data_path" default="/tmp/liorf_maps/hba/"/>
  <arg name="total_layer_num" default="3"/>
  <arg name="pcd_name_fill_num" default="0"/>
  <arg name="thread_num" default="16"/>
  <arg name="rviz" default="0"/>

  <node pkg="hba" type="hba" name="hba" output="screen">
    <param name="data_path" type="string" value="$(arg data_path)"/>
    <param name="total_layer_num" type="int" value="$(arg total_layer_num)"/>
    <param name="pcd_name_fill_num" type="int" value="$(arg pcd_name_fill_num)"/>
    <param name="thread_num" type="int" value="$(arg thread_num)"/>
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
      args="-d $(find hba)/rviz_cfg/rosbag.rviz"/>
  </group>
</launch>
